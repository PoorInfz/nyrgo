// The game app (PWA) as a Cloudflare Worker with static assets: serves apps/web/dist and sends
// every unknown path to index.html (client-side routes like /auth/verify). Built from the root:
//   build:  pnpm --filter "@nyrgo/web..." build
//   deploy: npx wrangler deploy --config apps/web/wrangler.jsonc
{
  "name": "nyrgo-app",
  "compatibility_date": "2026-10-01",
  // the app's address; deploying creates the custom domain and its DNS record
  "routes": [{ "pattern": "app.nyrgo.fun", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
