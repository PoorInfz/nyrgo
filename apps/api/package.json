{
  "name": "@nyrgo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language sql",
    "db:rollback": "node-pg-migrate down --migrations-dir migrations --migration-file-language sql",
    "world:import": "tsx --env-file-if-exists=../../.env scripts/import-osm.ts",
    "world:seed": "tsx --env-file-if-exists=../../.env scripts/seed-dev.ts",
    "nft:species": "tsx scripts/nft-species.ts",
    "nft:samples": "tsx scripts/nft-samples.ts",
    "nft:deploy": "tsx scripts/nft-deploy.mts",
    "jobs:run": "tsx --env-file-if-exists=../../.env scripts/run-job.ts",
    "content:sync": "tsx --env-file-if-exists=../../.env scripts/sync-content.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@nyrgo/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.7",
    "near-api-js": "7.4.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
