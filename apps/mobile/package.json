{
  "name": "@nyrgo/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "nyrGo! for Android: the web app in a Capacitor shell, with native location (mock-location detection) and device attestation.",
  "scripts": {
    "sync": "pnpm --filter \"@nyrgo/web...\" build && cap sync android",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "typescript": "^6.0.3"
  }
}
