# Copy to .env for local development. Never commit real secrets.
# Production values come from the secret manager, not from files.

NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Database (local Docker Compose defaults)
DATABASE_URL=postgres://nyrgo:nyrgo@localhost:5432/nyrgo

# Enables /dev/v1/* (GPS simulator). Refused at startup when NODE_ENV=production.
ENABLE_DEV_ROUTES=true

# Accounts
APP_URL=http://localhost:5173
# Sign-in links are printed to the API log until a real email provider is added.
MAIL_DRIVER=log
DEFAULT_REGION=ES

# Seeds wild spawns. Anyone holding it can predict where creatures appear; in production use a
# random value of 32+ characters (for example `openssl rand -hex 32`).
SPAWN_SECRET=dev-only-spawn-secret-change-me

# Admin panel access: name:role:token entries separated by commas (role reviewer|admin,
# token 32+ characters, e.g. `openssl rand -hex 24`). Empty disables the admin API.
ADMIN_TOKENS=dev:admin:dev-only-admin-token-0000000000000000

# Web
VITE_API_URL=http://localhost:3000
